{
  "name": "@jephal/pi-setup",
  "version": "0.0.7",
  "description": "Jeppe's consolidated Pi setup with planning, approvals, memory, Herdr, subagents, and a local notes application",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/jephal/pi-setup.git",
  "homepage": "https://github.com/jephal/pi-setup#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-setup"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "install.sh",
    "LICENSE",
    "THIRD-PARTY-NOTICES",
    "extensions",
    "src",
    "viewer/dist",
    "viewer/package.json",
    "viewer/package-lock.json",
    "skills",
    "agents",
    "prompts"
  ],
  "scripts": {
    "build:viewer": "npm --prefix viewer ci && npm --prefix viewer run build",
    "check:package": "node scripts/verify-package.mjs",
    "test": "node --experimental-strip-types --test extensions/*.test.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "grok-mermaid": "^0.2.2",
    "pi-fovea": "git+https://github.com/jephal/pi-fovea.git#v0.18.5-agent-safe.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/temp-storage.ts",
      "extensions/subagent/index.ts",
      "extensions/ask-questions.ts",
      "extensions/plan-mode.ts",
      "extensions/scheduled-tasks.ts",
      "extensions/notes.ts",
      "extensions/repo-search.ts",
      "extensions/visualization.ts",
      "extensions/approval-modes.ts",
      "extensions/memory.ts",
      "node_modules/pi-fovea/src/index.ts",
      "extensions/datadog-mcp.ts",
      "extensions/herdr-shell.ts"
    ],
    "prompts": [
      "prompts/*.md"
    ],
    "skills": [
      "node_modules/pi-fovea/skills"
    ]
  },
  "bundledDependencies": [
    "pi-fovea"
  ],
  "bundleDependencies": [
    "pi-fovea"
  ]
}
