{
  "name": "@jephal/pi-setup",
  "version": "0.1.0",
  "description": "Jeppe's consolidated Pi setup with planning, approvals, memory, Herdr, subagents, and a local notes application",
  "bin": {
    "notes-tui": "src/notes/tui.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/jephal/pi-setup.git",
  "homepage": "https://github.com/jephal/pi-setup#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-setup"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "extensions",
    "src",
    "skills",
    "agents",
    "prompts"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test extensions/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pi-fovea": "git+https://github.com/jephal/pi-fovea.git#v0.18.4-agent-safe.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/subagent/index.ts",
      "extensions/ask-questions.ts",
      "extensions/plan-mode.ts",
      "extensions/approval-modes.ts",
      "extensions/memory.ts",
      "extensions/notes.ts",
      "node_modules/pi-fovea/src/index.ts",
      "extensions/datadog-mcp.ts",
      "extensions/herdr-shell.ts"
    ],
    "prompts": [
      "prompts/*.md"
    ],
    "skills": [
      "node_modules/pi-fovea/skills"
    ]
  },
  "bundledDependencies": [
    "pi-fovea"
  ],
  "bundleDependencies": [
    "pi-fovea"
  ]
}
